{
  "buildCommand": "vite build && esbuild server/_core/vercelEntry.ts --bundle --platform=node --format=esm --packages=external --loader:.html=text --outfile=dist/vercel/index.js",
  "outputDirectory": "dist/public",
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/sweep-orphans", "schedule": "0 3 * * *" }
  ]
}
